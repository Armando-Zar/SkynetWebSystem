            <from-outcome>salir</from-outcome>
            <to-view-id>/index.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>consultaVisita</from-outcome>
            <to-view-id>/consultaVisitaTecnico.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule> 

<!-- REGLA NAVEGACIÓN ROLES INDEX -->   
    <navigation-rule>
        <navigation-case>
            <from-outcome>menuAdministrador</from-outcome>
            <to-view-id>/menuAdministrador.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>menuSupervisor</from-outcome>
            <to-view-id>/menuSupervisor.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>menuTecnico</from-outcome>
            <to-view-id>/menuTecnico.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>

<!-- VERIFICAR PARA ELIMINAR ESTA NAVEGACIÓN, SE DEJA COMENTADA -->   
    <navigation-rule>
        <from-view-id>/consultaCliente.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>menuAdministrador</from-outcome>
            <to-view-id>/menuAdministrador.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>menuSupervisor</from-outcome>
            <to-view-id>/menuSupervisor.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>
    
    
