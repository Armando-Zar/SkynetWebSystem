        </navigation-case>       
        <navigation-case>
            <from-outcome>nuevaVisita</from-outcome>
            <to-view-id>/registroVisita.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>consultaVisita</from-outcome>
            <to-view-id>/consultaVisita.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>nuevoAdministrador</from-outcome>
            <to-view-id>/registroAdministrador.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>consultaAdministrador</from-outcome>
