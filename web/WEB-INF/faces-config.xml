        </navigation-case>
        <navigation-case>
            <from-outcome>nuevoSupervisor</from-outcome>
            <to-view-id>/registroSupervisor.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>consultaSupervisor</from-outcome>
            <to-view-id>/consultaSupervisor.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>nuevoTecnico</from-outcome>
            <to-view-id>/registroTecnico.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>consultaTecnico</from-outcome>
            <to-view-id>/consultaTecnico.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>nuevoRol</from-outcome>
            <to-view-id>/registroRol.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>consultaRol</from-outcome>
            <to-view-id>/consultaRol.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>nuevoUsuario</from-outcome>
            <to-view-id>/registroUsuario.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>consultaUsuario</from-outcome>
