        <from-view-id>/menuAdministrador.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>salir</from-outcome>
            <to-view-id>/index.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>nuevoCliente</from-outcome>
