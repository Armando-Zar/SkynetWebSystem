        </navigation-case>
    </navigation-rule>
    
<!-- REGLA NAVEGACIÓN PARA ROL SUPERVISOR 3 ITEMS EN SWITCH CASE -->      
    <navigation-rule>
        <from-view-id>/menuSupervisor.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>salir</from-outcome>
            <to-view-id>/index.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>nuevaVisita</from-outcome>
