<!-- REGLA NAVEGACIÓN INDEX de IndexModelo  -->    
    <navigation-rule>
        <from-view-id>/index.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>administrador</from-outcome>
            <to-view-id>/menuAdministrador.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>supervisor</from-outcome>
            <to-view-id>/menuSupervisor.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>tecnico</from-outcome>
            <to-view-id>/menuTecnico.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>usuarioInactivo</from-outcome>
            <to-view-id>/index.xhtml</to-view-id>
        </navigation-case>      
        <navigation-case>
            <from-outcome>usuarioIncorrecto</from-outcome>
            <to-view-id>/index.xhtml</to-view-id>
        </navigation-case>            
    </navigation-rule> 

<!-- REGLA NAVEGACIÓN PARA ROL ADMINISTRADOR 15 ITEMS EN SWITCH CASE -->  
