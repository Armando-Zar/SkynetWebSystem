	<parameter name="id_visita" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	
        <queryString>
		<![CDATA[SELECT v.id_visita,
       v.id_cliente,
       v.falla_reportada,
       v.fecha_programada,
       v.id_tecnico,
       v.ingreso,
       v.egreso,
       v.nota,
       c.nombre AS cliente,
       t.nombre AS tecnico
FROM visita v
INNER JOIN cliente c ON c.id_cliente = v.id_cliente
INNER JOIN tecnico t ON t.id_tecnico = v.id_tecnico
WHERE v.id_visita = $P{id_visita}
]]>
	</queryString>








